<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.merlin.bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/fred/Developer/ai/merlin-voice/venv/bin/python</string>
    <string>/Users/fred/Developer/ai/merlin-voice/bot.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/fred/Developer/ai/merlin-voice</string>
  <!-- launchd ne donne que /usr/bin:/bin:/usr/sbin:/sbin : sans ceci l'atelier
       ne trouve ni agy (~/.local/bin) ni codex (/opt/homebrew/bin) — vu le 26/09. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/fred/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>/tmp/merlin-bot.log</string>
  <key>StandardErrorPath</key><string>/tmp/merlin-bot.log</string>
</dict>
</plist>
